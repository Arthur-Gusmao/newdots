{
  "layer": "top",
  "position": "bottom",
  "height": 24,
  "width": 1050,
  "spacing": 0,
  "margin": "1",

  "modules-left": ["custom/logo", "custom/sep-left1", "ext/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["battery", "clock#date"],

  "custom/logo": {
    "format": "\uf300",
    "tooltip": false
  },

  "custom/sep-left1": {
    "format": "|",
    "tooltip": false
  },

  "ext/workspaces": {
    "format": "{name}",
    "sort-by-id": true,
    "on-click": "activate",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "clock": {
    "format": "{:%A %H:%M}",
    "format-alt": "{:%d %B W%V %Y}",
    "tooltip": false
  },

  "clock#date": {
    "format": "{:%d/%m/%Y}",
    "tooltip": false
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "battery": {
    "format": "{capacity}%",
    "format-discharging": "{capacity}%",
    "format-charging": "{capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  }
}
