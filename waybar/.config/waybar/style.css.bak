@define-color bg #060a07;
@define-color fg #e6e1dc;

* {
    font-family: "IosevkaTerm Nerd Font", monospace;
    font-style: normal;
    font-size: 14px;
    min-height: 0;
}

window#waybar {
    background-color: @bg;
    color: @fg;
    border-radius: 0;
}

#battery,
#custom-user,
#custom-sep-left2,
#workspaces,
#clock,
#custom-separator,
#cpu,
#temperature,
#custom-window,
#custom-date {
    padding: 0 8px;
    color: @fg;
}

#custom-logo {
    font-weight: normal;
    color: @fg;
    padding: 0 9px;
}


#custom-sep-left1,
#custom-sep-left2,
#custom-separator {
    color: @fg;
    opacity: 0.3;
    padding: 0 4px;
}

#workspaces button {
    padding: 0 1px;
    margin: 2px 2px;
    color: @fg;
    background: none;
    border: none;
    border-radius: 0;
}

#workspaces button.active {
    color: @bg;
    background-color: @fg;
    border-radius: 0;
}

#battery {
    color: @fg;
    margin-left: -6px;
}

#clock,
#cpu,
#temperature,
#custom-window,
#custom-date {
    color: @fg;
}

#temperature.critical {
    color: @fg;
    font-weight: bold;
}
